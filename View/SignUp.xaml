<Window x:Class="Calculator.View.SignUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator.View"
        mc:Ignorable="d"
        Title="회원가입" Height="400" Width="320"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseWindowStyle}">
    
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">

            <!-- 아이디 -->
            <Grid Width="200" Height="30" Margin="0,5">
                <TextBox x:Name="IdInput" TextChanged="IdInput_TextChanged"/>
                <TextBlock Text="아이디"
                           Foreground="Gray"
                           Margin="5,2,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Visibility="Visible"
                           Name="IdHint"/>
            </Grid>

            <!-- 비밀번호 -->
            <Grid Width="200" Height="30" Margin="0,5">
                <PasswordBox x:Name="PwInput" PasswordChanged="PwInput_PasswordChanged"/>
                <TextBlock Text="비밀번호"
                           Foreground="Gray"
                           Margin="5,2,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Visibility="Visible"
                           Name="PwHint"/>
            </Grid>

            <!-- 비밀번호 확인 -->
            <Grid Width="200" Height="30" Margin="0,5">
                <PasswordBox x:Name="PwConfirmInput" PasswordChanged="PwConfirmInput_PasswordChanged"/>
                <TextBlock Text="비밀번호 확인"
                           Foreground="Gray"
                           Margin="5,2,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Visibility="Visible"
                           Name="PwConfirmHint"/>
            </Grid>

            <!-- 이메일 -->
            <Grid Width="200" Height="30" Margin="0,5">
                <TextBox x:Name="EmailInput" TextChanged="EmailInput_TextChanged"/>
                <TextBlock Text="이메일"
                           Foreground="Gray"
                           Margin="5,2,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Visibility="Visible"
                           Name="EmailHint"/>
            </Grid>

            <!-- 회원가입 버튼 -->
            <Button Content="회원가입" Width="100" Margin="0,20,0,0"
                    Click="SignUpButton_Click"
                    Style="{StaticResource BaseButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
