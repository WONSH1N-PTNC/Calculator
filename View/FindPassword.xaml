<Window x:Class="Calculator.View.FindPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator.View"
        mc:Ignorable="d"
        Title="FindPassword" Height="260" Width="350"
        Style="{StaticResource BaseWindowStyle}">
    <Grid Margin="20">
        <StackPanel>

            <!-- 아이디 -->
            <Grid Width="200" Height="30" Margin="0,5">
                <TextBox x:Name="IdInput" TextChanged="IdInput_TextChanged"/>
                <TextBlock Text="아이디"
                           Foreground="Gray"
                           Margin="5,2,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Visibility="Visible"
                           Name="IdHint"/>
            </Grid>

            <!-- 이메일 -->
            <Grid Width="200" Height="30" Margin="0,5">
                <TextBox x:Name="EmailInput" TextChanged="EmailInput_TextChanged"/>
                <TextBlock Text="이메일"
                           Foreground="Gray"
                           Margin="5,2,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Visibility="Visible"
                           Name="EmailHint"/>
            </Grid>

            <Button Content="비밀번호 찾기"
                    Width="150" Height="30"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Click="FindButton_Click"
                    Style="{StaticResource BaseButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
